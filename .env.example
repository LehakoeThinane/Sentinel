# Copy to .env and replace every value. Placeholders only: never put real
# secrets in this file. `make up` passes .env to docker compose; without it,
# compose uses local-only defaults.

# PostgreSQL superuser for the local container
POSTGRES_USER=sentinel_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinel

# One login role per service; each owns only its own schema
PAYMENTS_SVC_PASSWORD=change-me
LEDGER_SVC_PASSWORD=change-me
CASES_SVC_PASSWORD=change-me
RECON_SVC_PASSWORD=change-me

# Redis and the Kafka-compatible broker (host-side addresses)
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:19092
