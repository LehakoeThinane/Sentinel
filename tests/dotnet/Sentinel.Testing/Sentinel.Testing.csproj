<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared test support: a PostgreSQL container initialised with the real
       local roles script. Referenced by the services' integration test projects. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
  </ItemGroup>

</Project>
