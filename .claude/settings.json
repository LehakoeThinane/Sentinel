{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet format *)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)",
      "Bash(docker compose up *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(dotnet add package *)",
      "Bash(pip install *)",
      "Bash(docker compose down *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(dotnet add package *)",
      "PowerShell(pip install *)",
      "PowerShell(docker compose down *)",
      "Edit(./.github/workflows/**)",
      "Edit(./infra/**)",
      "Edit(./services/**/Migrations/**)",
      "Edit(./CLAUDE.md)",
      "Edit(./.claude/**)",
      "Edit(./.gitignore)",
      "Edit(./planning/**)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./**/secrets/**)",
      "Bash(git add -f *)",
      "Bash(git add --force *)",
      "Bash(git add planning*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(az *)",
      "Bash(rm -rf *)",
      "PowerShell(git add -f *)",
      "PowerShell(git add --force *)",
      "PowerShell(git add planning*)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(terraform apply *)",
      "PowerShell(terraform destroy *)",
      "PowerShell(az *)",
      "PowerShell(rm -rf *)",
      "PowerShell(Remove-Item * -Recurse *)",
      "PowerShell(Remove-Item -Recurse *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh\"",
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.sh\""
          }
        ]
      }
    ]
  }
}
